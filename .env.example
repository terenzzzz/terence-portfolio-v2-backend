PORT=3002
# Comma-separated origins. Leave empty to allow any origin.
CORS_ORIGIN=https://terenzzzz.cn,https://www.terenzzzz.cn,http://localhost:8080
# Bark device key from https://api.day.app/<key>
BARK_KEY=
BARK_API=https://api.day.app
# How long to wait before pushing again for the same visitor IP.
VISIT_PUSH_WINDOW_MS=3600000
# Visit records are stored in this database. Leave empty to skip saving.
MONGODB_URI=mongodb://portfolio:password@127.0.0.1:27017/portfolio?authSource=portfolio
MONGODB_DB=portfolio
MONGODB_COLLECTION=visits
# Password required by GET /api/stats, sent in the X-Stats-Password header.
STATS_PASSWORD=change-me
